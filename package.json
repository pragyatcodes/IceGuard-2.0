{
  "name": "iceguard",
  "version": "1.0.0",
  "private": true,
  "description": "ICEGUARD - AI-enabled Antarctic sea-ice, iceberg trajectory and navigation decision support system (SIH26059 / MoES)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "fit:residual": "tsx --tsconfig tsconfig.json scripts/fit-residual.ts",
    "verify": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.24",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
