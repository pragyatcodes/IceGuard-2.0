// ICEGUARD — SIH26059 (MoES)
// Vector store. Analysis §6.2 calls for PostGIS; SQLite is the zero-setup dev
// provider so the app runs anywhere. Swap the provider block to `postgresql`
// and set DATABASE_URL for production (see README §Deploy). All geometry is
// stored as WGS84 lat/lon and projected to polar stereographic in code, so no
// provider-specific GIS extension is required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  OPERATOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role     @default(VIEWER)
  passwordHash String
  createdAt    DateTime @default(now())

  advices   Advice[]    @relation("AdviceAuthor")
  overrides AuditLog[]  @relation("AuditUser")
}

/// Feed health. Drives the green/amber/red dots in the console top bar.
/// Analysis §5.1 + L8 (stale data): if SAR age > threshold the badge cannot be GO.
model DataSource {
  id         String   @id @default(cuid())
  code       String   @unique // SENTINEL1 | AMSR2 | NSIDC | ERA5 | CMEMS | MOSDAC
  name       String
  category   String // SAR | ICE | WIND | CURRENT | SHIP
  status     String @default("GREEN") // GREEN | AMBER | RED
  lastUpdate DateTime
  note       String?
}

/// A tracked berg. Analysis §3: Antarctic bergs are often tabular and
/// current-dominated, not wind-dominated (L6).
model Iceberg {
  id           String   @id @default(cuid())
  bergId       String   @unique // A23a, C-23, B-49 ...
  displayName  String
  sizeClass    String // GIANT | LARGE | MEDIUM | SMALL
  regime       String @default("OPEN") // OPEN | DRAG | LOCK
  areaKm2      Float
  lengthKm     Float
  widthKm      Float
  keelDepthM   Float
  massGt       Float
  lat          Float
  lon          Float
  speedKt      Float
  headingDeg   Float
  sicAtBerg    Float // sea-ice concentration at berg location, 0..1
  grounded     Boolean  @default(false) // L7
  splitOf      String? // L13: ID-swap / breakup provenance
  lastObserved DateTime
  source       String   @default("BYU/NSIDC")
  notes        String?

  positions  BergPosition[]
  forecasts  Forecast[]
  advices    Advice[]
}

/// Observed + ingested state samples on the polar grid.
model BergPosition {
  id         String   @id @default(cuid())
  icebergId  String
  observedAt DateTime
  lat        Float
  lon        Float
  sic        Float
  windU      Float
  windV      Float
  currentU   Float
  currentV   Float
  isObserved Boolean  @default(true)
  source     String   @default("BYU/NSIDC")

  iceberg Iceberg @relation(fields: [icebergId], references: [id], onDelete: Cascade)

  @@index([icebergId, observedAt])
}

/// A physics+residual drift run with its conformal cone.
model Forecast {
  id            String   @id @default(cuid())
  icebergId     String
  modelVersion  String
  issuedAt      DateTime
  horizonHours  Int
  pathJson      String // [{t,lat,lon,sic,regime}]
  coneJson      String // [{t,crossKm,alongKm,poly:[[lat,lon]...]}]
  forcesJson    String // wind/current/ice percentages (XAI force tags)
  coneWidthKm   Float
  coverage      Float // calibrated coverage of the 90% set
  maeKm72       Float?

  iceberg Iceberg @relation(fields: [icebergId], references: [id], onDelete: Cascade)

  @@index([icebergId, issuedAt])
}

/// A planned ship track (corridor) for scoring.
model Voyage {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  vessel       String
  hullClass    String // ICE_CLASS_1A | ICE_CLASS_1C | NON_ICE
  origin       String
  destination  String
  departAt     DateTime
  etaAt        DateTime
  speedKt      Float
  bufferNm     Float // hull safety buffer, nautical miles
  corridorJson String // [[lat,lon]...]
  status       String   @default("PLANNED")

  advices Advice[]
}

/// The traffic light. Analysis §4.5.
model Advice {
  id              String    @id @default(cuid())
  voyageId        String
  icebergId       String?
  light           String // GO | SLOW | NO_GO
  reason          String // the one human sentence (XAI)
  timeToHazardH   Float?
  minClearanceKm  Float
  maxIceOnRoute   Float
  coneWidthKm     Float
  degraded        Boolean   @default(false)
  acknowledged    Boolean   @default(false)
  acknowledgedBy  String?
  createdAt       DateTime  @default(now())

  voyage  Voyage   @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  iceberg Iceberg? @relation(fields: [icebergId], references: [id])
  author  User?    @relation("AdviceAuthor", fields: [acknowledgedBy], references: [id])

  @@index([voyageId, createdAt])
}

/// Every GO/NO-GO and every override is logged. Analysis §10.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // OVERRIDE | ACK | THRESHOLD | MODEL_FREEZE | LOGIN
  entity    String
  entityId  String?
  reason    String?
  payload   String?
  createdAt DateTime @default(now())

  user User? @relation("AuditUser", fields: [userId], references: [id])

  @@index([createdAt])
}

/// Model provenance so a replay next month uses the same weights (§10).
model ModelVersion {
  id         String   @id @default(cuid())
  version    String   @unique
  frozen     Boolean  @default(false)
  metrics    String // {maeKm24,maeKm48,maeKm72,f1,coverage}
  createdAt  DateTime @default(now())
}

/// Thresholds are configuration, not religion (§4.5).
model Threshold {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Float
  unit      String
  updatedBy String?
}
